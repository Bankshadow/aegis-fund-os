{
  "name": "Aegis Runtime Watchdog (read-only)",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "minutes", "minutesInterval": 15 }] } },
      "id": "schedule", "name": "Every 15 minutes", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1, "position": [260, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.AEGIS_RUNTIME_STATUS_URL }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Aegis-Automation-Token", "value": "={{ $env.AEGIS_AUTOMATION_STATUS_TOKEN }}" }] },
        "options": { "timeout": 10000 }
      },
      "id": "status", "name": "Read Aegis runtime status", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [500, 300]
    },
    {
      "parameters": { "conditions": { "options": { "caseSensitive": true }, "conditions": [{ "leftValue": "={{ $json.safety.haltedBots + $json.safety.failedRuns }}", "rightValue": 0, "operator": { "type": "number", "operation": "gt" } }] } },
      "id": "attention", "name": "Needs operator attention?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [740, 300]
    },
    {
      "parameters": { "assignments": { "assignments": [{ "name": "alert", "value": "=Aegis alert: {{ $json.safety.haltedBots }} halted bot(s), {{ $json.safety.failedRuns }} failed runtime run(s).", "type": "string" }] }, "options": {} },
      "id": "alert", "name": "Build alert payload", "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [980, 200], "disabled": true
    }
  ],
  "connections": { "Every 15 minutes": { "main": [[{ "node": "Read Aegis runtime status", "type": "main", "index": 0 }]] }, "Read Aegis runtime status": { "main": [[{ "node": "Needs operator attention?", "type": "main", "index": 0 }]] }, "Needs operator attention?": { "main": [[{ "node": "Build alert payload", "type": "main", "index": 0 }], []] } },
  "active": false,
  "settings": { "executionOrder": "v1", "timezone": "Asia/Bangkok" },
  "versionId": "aegis-runtime-watchdog-v1"
}
